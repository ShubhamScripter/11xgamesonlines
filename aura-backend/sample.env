# DATABASE
MONGO_URI=


# AUTHENTICATION
JWT_SECRET=


# EXTERNAL API (Sports/Casino Provider)
API_URL=
API_KEY=

# RESULT API (Bet Placement & Result Declaration)
RESULT_API_URL=


# SERVER CONFIGURATION

NODE_ENV=local
PORT=3000
APP_TYPE=client

# Separate ports for different apps
CLIENT_PORT=8000
DASHBOARD_PORT=8001


# FEATURE FLAGS
DEV_MOCK_API=0

# SPORTS LIST CACHE (cricket / soccer / tennis only)
SPORTS_CACHE_CRON_ENABLED=true
SPORTS_CACHE_CRON_SEC=15
SPORTS_CACHE_TTL_SEC=120
SPORTS_CACHE_REPAIR_ENABLED=true
SPORTS_CACHE_REPAIR_SEC=20

# Redis (optional — omit for in-memory cache on single server)
# Free options: Upstash.com or Redis Cloud (redis.io/cloud)
# REDIS_URL=rediss://default:PASSWORD@HOST.upstash.io:6379
