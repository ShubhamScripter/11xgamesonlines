# DATABASE
MONGO_URI=


# AUTHENTICATION
JWT_SECRET=


# EXTERNAL API (Sports/Casino Provider)
API_URL=
API_KEY=

# RESULT API (Bet Placement & Result Declaration)
RESULT_API_URL=


# SERVER CONFIGURATION

NODE_ENV=local
PORT=3000
APP_TYPE=client

# Separate ports for different apps
CLIENT_PORT=8000
DASHBOARD_PORT=8001


# FEATURE FLAGS
DEV_MOCK_API=0

# BETFAIR COMPETITION CATALOG (providerD — competition-list → MongoDB)
BETFAIR_COMPETITION_SYNC_ENABLED=true
BETFAIR_COMPETITION_SYNC_MIN=30
BETFAIR_COMPETITION_STALE_MIN=35

# BETFAIR EVENT CATALOG (providerD — event-list per competition → MongoDB)
BETFAIR_EVENT_SYNC_ENABLED=true
BETFAIR_EVENT_SYNC_MIN=15
BETFAIR_EVENT_STALE_MIN=18

# BETFAIR MARKET CATALOG (providerD — market-all-list per event → MongoDB)
BETFAIR_MARKET_SYNC_ENABLED=true
BETFAIR_MARKET_SYNC_MIN=7
BETFAIR_MARKET_STALE_MIN=10

# BETFAIR ODDS SYNC (in-memory + WebSocket — no MongoDB model)
BETFAIR_ODDS_SYNC_ENABLED=true
BETFAIR_ODDS_SYNC_MS=1000
BETFAIR_ODDS_SYNC_CONCURRENCY=8
BETFAIR_ODDS_STALE_MS=3000
BETFAIR_ODDS_LOG_EVERY=60

# SPORTS LIST CACHE (cricket / soccer / tennis only)
SPORTS_CACHE_CRON_ENABLED=true
SPORTS_CACHE_CRON_SEC=15
SPORTS_CACHE_TTL_SEC=120
SPORTS_CACHE_REPAIR_ENABLED=true
SPORTS_CACHE_REPAIR_SEC=20

# Redis (optional — omit for in-memory cache on single server)
# Free options: Upstash.com or Redis Cloud (redis.io/cloud)
# REDIS_URL=rediss://default:PASSWORD@HOST.upstash.io:6379
